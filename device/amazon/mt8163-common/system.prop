# Display / headless (stock Biscuit values, minus Mali gralloc override)
ro.build.configuration=headless
ro.build.characteristics=headless
ro.opengles.version=196608
ro.config.no_gpu=true
ro.zygote.preload.enable=0
ro.zygote.disable_res_preload=1
ro.zygote.disable_gl_preload=1
ro.zygote.disable_lib_preload=1
ro.zygote.disable_wv_preload=1
ro.zygote.disable_java_preload=1

# SurfaceFlinger
ro.sf.lcd_density=240
ro.sf.hwrotation=0
debug.sf.headless=1
debug.sf.nobootanimation=1

# USB
ro.usb.vid=1949

# MTK connectivity/audio props read by stock Biscuit blobs.
wifi.interface=wlan0
ro.mediatek.platform=MT8163
ro.btstack=bluedroid
persist.service.bt.a2dp.sink=true
persist.mtk.wcn.combo.chipid=-1
mediatek.wlan.chip=CONSYS_MT8163
mediatek.wlan.module.postfix=_consys_mt8163
ro.mtk_wlan_support=1
ro.mtk_wifi_mcc_support=1
ro.mtk_dhcpv6c_wifi=1
ro.mtk_bt_support=1
ro.mtk_audio_profiles=1