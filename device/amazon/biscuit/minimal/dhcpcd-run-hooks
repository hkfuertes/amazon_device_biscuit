#!/system/bin/sh
# Minimal dhcpcd hook for the framework-free Biscuit image.
# dhcpcd receives DNS servers from DHCP; without Android's framework/netd,
# Linux/Go programs need those servers written to /etc/resolv.conf.

case "$reason" in
    BOUND|RENEW|REBIND|REBOOT|INFORM|STATIC)
        [ -n "$new_domain_name_servers" ] || exit 0
        mkdir -p /data/misc/resolv
        tmp=/data/misc/resolv/resolv.conf.tmp
        out=/data/misc/resolv/resolv.conf
        {
            echo '# Generated by dhcpcd for Biscuit minimal.'
            if [ -n "$new_domain_search" ]; then
                echo "search $new_domain_search"
            elif [ -n "$new_domain_name" ]; then
                echo "domain $new_domain_name"
            fi
            for server in $new_domain_name_servers; do
                case "$server" in
                    *[!0-9a-fA-F:.:]*|'') ;;
                    *) echo "nameserver $server" ;;
                esac
            done
        } > "$tmp" && mv "$tmp" "$out"
        chmod 0644 "$out"
        ;;
    EXPIRE|FAIL|IPV4LL|RELEASE|STOP)
        rm -f /data/misc/resolv/resolv.conf
        ;;
esac

exit 0
