#!/system/bin/sh
# Minimal dhcpcd hook for the framework-free Biscuit image.
# dhcpcd receives DNS servers from DHCP. Publish them to both Linux/Go
# (/etc/resolv.conf) and Android's native resolver (netd/dnsproxyd).

valid_dns_servers() {
    servers=
    for server in $new_domain_name_servers; do
        case "$server" in
            *[!0-9a-fA-F:.:]*|'') ;;
            *) servers="$servers $server" ;;
        esac
    done
    servers=${servers# }
    [ -n "$servers" ]
}

write_resolv_conf() {
    mkdir -p /data/misc/resolv
    tmp=/data/misc/resolv/resolv.conf.tmp
    out=/data/misc/resolv/resolv.conf
    {
        echo '# Generated by dhcpcd for Biscuit minimal.'
        if [ -n "$new_domain_search" ]; then
            echo "search $new_domain_search"
        elif [ -n "$new_domain_name" ]; then
            echo "domain $new_domain_name"
        fi
        for server in $servers; do
            echo "nameserver $server"
        done
    } > "$tmp" && mv "$tmp" "$out"
    chmod 0644 "$out"
}

publish_netd_dns() {
    [ -x /system/bin/ndc ] || return 0
    domains=${new_domain_search:-$new_domain_name}
    tries=0
    while [ "$tries" -lt 10 ]; do
        if /system/bin/ndc resolver setnetdns 0 "$domains" $servers >/dev/null 2>&1; then
            return 0
        fi
        tries=$((tries + 1))
        sleep 1
    done
    return 0
}

clear_netd_dns() {
    [ -x /system/bin/ndc ] || return 0
    /system/bin/ndc resolver clearnetdns 0 >/dev/null 2>&1 || true
}

case "$reason" in
    BOUND|RENEW|REBIND|REBOOT|INFORM|STATIC)
        [ -n "$new_domain_name_servers" ] || exit 0
        valid_dns_servers || exit 0
        write_resolv_conf
        publish_netd_dns
        ;;
    EXPIRE|FAIL|IPV4LL|RELEASE|STOP)
        rm -f /data/misc/resolv/resolv.conf
        clear_netd_dns
        ;;
esac

exit 0
