# Android fstab for Biscuit CM14.1 minimal on amonet v2.
# Runtime mounts use fs_mgr slotselect; OTA writes are handled by releasetools current-slot aliases.

#<src>                                             <mnt_point> <type> <mnt_flags and options>                          <fs_mgr_flags>
/dev/block/platform/bootdevice/by-name/system     /system     ext4   ro                                                wait,slotselect
/dev/block/platform/bootdevice/by-name/userdata   /data       ext4   noatime,nosuid,nodev,noauto_da_alloc,discard       check,encryptable=/dev/block/platform/bootdevice/by-name/metadata,latemount
/dev/block/platform/bootdevice/by-name/cache      /cache      ext4   noatime,nosuid,nodev,noauto_da_alloc               wait,check

/dev/block/platform/bootdevice/by-name/boot       /boot       emmc   defaults                                          slotselect
/dev/block/platform/bootdevice/by-name/recovery   /recovery   emmc   defaults                                          defaults
/dev/block/platform/bootdevice/by-name/misc       /misc       emmc   defaults                                          defaults

/devices/platform/soc/11271000.usb*               auto        vfat   defaults                                          voldmanaged=usbotg:auto
/dev/block/zram0                                  none        swap   defaults                                          zramsize=805306368,zramstreams=3
