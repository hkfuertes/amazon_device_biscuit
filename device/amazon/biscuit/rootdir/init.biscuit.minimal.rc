# Hardware services for the framework-free Biscuit CM14.1 minimal base.

on fs
    mount_all /fstab.mt8163

on post-fs
    swapon_all /fstab.mt8163
    write /proc/sys/vm/page-cluster 0

on post-fs-data
    mkdir /data/misc 01771 system misc
    mkdir /data/nvram 0771 root system
    mkdir /data/nvram/media 0770 media audio
    mkdir /data/@btmtk 0770 bluetooth net_bt

    mkdir /data/misc/wifi 0770 wifi wifi
    mkdir /data/misc/wifi/sockets 0770 wifi wifi
    mkdir /data/misc/wifi/wpa_supplicant 0770 wifi wifi
    mkdir /data/misc/wpa_supplicant 0770 wifi wifi
    mkdir /data/misc/dhcp 0770 dhcp wifi
    mkdir /data/misc/dhcp-6.8.2 0770 dhcp wifi
    mkdir /data/wifi 0771 wifi wifi

    # Amazon's audio HAL and the tinyalsa route use this GPIO sysfs node.
    chown root audio /sys/devices/soc/1000b000.pinctrl/mt_gpio
    chmod 0664 /sys/devices/soc/1000b000.pinctrl/mt_gpio

    start audio_init
    # Keep a stock-compatible daemon slot available to system-only add-ons.
    start ledcontroller

on boot
    chmod 0660 /dev/stpwmt
    chmod 0660 /dev/wmtWifi
    chmod 0660 /dev/stpbt
    chown system system /dev/stpwmt
    chown system system /dev/wmtWifi
    chown bluetooth bluetooth /dev/stpbt
    start wmt_loader
    start wmt_launcher

on boot
    start wifi_bootstrap

on property:sys.biscuit.wifi.ready=1
    start wpa_supplicant

on property:init.svc.wpa_supplicant=running
    start wifi_events

on property:init.svc.wpa_supplicant=stopped
    stop wifi_events
    stop dhcpcd_wlan0

service audio_init /system/bin/sh /system/etc/audio_init.sh
    user root
    group root
    oneshot
    disabled

service wmt_loader /vendor/bin/wmt_loader
    class core
    user root
    group root system
    oneshot
    disabled

service wmt_launcher /vendor/bin/wmt_launcher -p /vendor/firmware/
    class core
    user system
    group system
    disabled

# The base target blocks harmlessly; a TWRP add-on may replace it with a daemon.
# Do not mark oneshot: init must supervise the replacement process.
service ledcontroller /system/bin/ledcontroller
    user root
    group shell system
    disabled

service wifi_bootstrap /system/bin/logwrapper /system/bin/sh /system/bin/wifi-bootstrap.sh
    user root
    group root
    oneshot
    disabled

# wpa_cli replaces only the framework's connection-event -> DHCP handoff.
service wifi_events /system/bin/wpa_cli -iwlan0 -p/data/misc/wifi/sockets -a/system/bin/wifi-bootstrap.sh
    user root
    group wifi inet
    disabled

service dhcpcd_wlan0 /system/bin/dhcpcd-6.8.2 -ABKL -f /system/etc/dhcpcd/dhcpcd.conf wlan0
    user root
    group dhcp wifi inet
    disabled
    oneshot

service wpa_supplicant /system/bin/wpa_supplicant \
    -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf -e/data/misc/wifi/entropy.bin \
    -I/system/etc/wifi/wpa_supplicant_overlay.conf \
    -O/data/misc/wifi/sockets -g@android:wpa_wlan0
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot
