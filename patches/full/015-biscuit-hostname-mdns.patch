+    private static String makeBiscuitHostname(Context context) {
+        String id = SystemProperties.get("ro.serialno", "");
+        if (!usableHostnameId(id)) id = SystemProperties.get("ro.boot.serialno", "");
+        if (!usableHostnameId(id)) {
+            id = Settings.Secure.getString(context.getContentResolver(), Settings.Secure.ANDROID_ID);
+        }
+        String suffix = hostnameSuffix(id);
+        String model = hostnameToken(SystemProperties.get("ro.product.model", "biscuit"));
+        return TextUtils.isEmpty(suffix) ? null : model + "-" + suffix;
+    }
+
+    private static String hostnameToken(String value) {
+        if (value == null) return "biscuit";
+        StringBuilder out = new StringBuilder();
+        boolean dash = false;
+        for (int i = 0; i < value.length(); i++) {
+            char ch = value.charAt(i);
+            if (ch >= '0' && ch <= '9') {
+                out.append(ch);
+                dash = false;
+            } else if (ch >= 'a' && ch <= 'z') {
+                out.append(ch);
+                dash = false;
+            } else if (ch >= 'A' && ch <= 'Z') {
+                out.append((char) (ch - 'A' + 'a'));
+                dash = false;
+            } else if (out.length() > 0 && !dash) {
+                out.append('-');
+                dash = true;
+            }
+        }
+        if (dash) out.setLength(out.length() - 1);
+        return out.length() == 0 ? "biscuit" : out.toString();
+    }
+
+    private static boolean usableHostnameId(String value) {
+        return !TextUtils.isEmpty(value) && !"unknown".equals(value.toLowerCase());
+    }
+
+    private static String hostnameSuffix(String value) {
+        if (value == null) return null;
+        StringBuilder out = new StringBuilder();
+        for (int i = 0; i < value.length(); i++) {
+            char ch = value.charAt(i);
+            if (ch >= '0' && ch <= '9') out.append(ch);
+            else if (ch >= 'a' && ch <= 'z') out.append(ch);
+            else if (ch >= 'A' && ch <= 'Z') out.append((char) (ch - 'A' + 'a'));
+        }
+        if (out.length() == 0) return null;
+        return out.substring(Math.max(0, out.length() - 3));
     }
 
