diff --git a/hardware/amazon/audio/audio_wrapper.c b/hardware/amazon/audio/audio_wrapper.c
new file mode 100644
index 0000000..6290c69
--- /dev/null
+++ b/hardware/amazon/audio/audio_wrapper.c
@@ -0,0 +1,53 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#define LOG_TAG "audio.amazon_wrapper"
+
+#include <errno.h>
+#include <string.h>
+
+#include <hardware/audio.h>
+#include <hardware/hardware.h>
+#include <log/log.h>
+
+static int adev_open(const struct hw_module_t* module, const char* name,
+                     struct hw_device_t** device) {
+    const struct hw_module_t* amazon_module;
+    int status;
+
+    (void)module;
+    if (strcmp(name, AUDIO_HARDWARE_INTERFACE) != 0) {
+        return -EINVAL;
+    }
+
+    status = hw_get_module_by_class(AUDIO_HARDWARE_MODULE_ID, "primary_amazon",
+                                    &amazon_module);
+    if (status != 0) {
+        ALOGE("cannot load FireOS primary audio module: %d", status);
+        return status;
+    }
+    if (!amazon_module->methods || !amazon_module->methods->open) {
+        ALOGE("FireOS primary audio module has no open method");
+        return -ENOSYS;
+    }
+
+    // ponytail: FireOS 6 and CM14 both expose audio-device API v3; forward it directly.
+    return amazon_module->methods->open(amazon_module, name, device);
+}
+
+static struct hw_module_methods_t hal_module_methods = {
+    .open = adev_open,
+};
+
+struct audio_module HAL_MODULE_INFO_SYM = {
+    .common = {
+        .tag = HARDWARE_MODULE_TAG,
+        .module_api_version = AUDIO_MODULE_API_VERSION_CURRENT,
+        .hal_api_version = HARDWARE_HAL_API_VERSION,
+        .id = AUDIO_HARDWARE_MODULE_ID,
+        .name = "Amazon FireOS audio HAL router",
+        .author = "The LineageOS Project",
+        .methods = &hal_module_methods,
+    },
+};
