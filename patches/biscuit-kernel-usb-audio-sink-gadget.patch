+/*
+ * Gadget Function Driver for USB audio sink device
+ *
+ * Minimal Biscuit speaker-side companion to f_audio_source.c:
+ * USB host playback -> ALSA capture PCM for userspace to drain.
+ */
+
+#include <linux/device.h>
+#include <linux/usb/audio.h>
+#include <linux/wait.h>
+#include <sound/core.h>
+#include <sound/initval.h>
+#include <sound/pcm.h>
+
+#define SINK_SAMPLE_RATE 44100
+#define SINK_BYTES_PER_FRAME 4
+#define SINK_FRAMES_PER_MSEC (SINK_SAMPLE_RATE / 1000)
+#define SINK_OUT_EP_MAX_PACKET_SIZE ((SINK_FRAMES_PER_MSEC + 1) * SINK_BYTES_PER_FRAME)
+#define SINK_OUT_EP_REQ_COUNT 16
+
+#define SINK_AUDIO_NUM_INTERFACES 2
+#define SINK_UAC_DT_AC_HEADER_LENGTH UAC_DT_AC_HEADER_SIZE(SINK_AUDIO_NUM_INTERFACES)
+#define SINK_UAC_DT_TOTAL_LENGTH (SINK_UAC_DT_AC_HEADER_LENGTH \
+	+ UAC_DT_INPUT_TERMINAL_SIZE + UAC_DT_OUTPUT_TERMINAL_SIZE \
+	+ UAC_DT_FEATURE_UNIT_SIZE(0))
+
+#define SINK_INPUT_TERMINAL_ID 1
+#define SINK_FEATURE_UNIT_ID 2
+#define SINK_OUTPUT_TERMINAL_ID 3
+
+/* f_audio_source.c declares these generated UAC descriptor struct types. */
+
+static struct usb_interface_descriptor audio_sink_ac_interface_desc = {
+	.bLength = USB_DT_INTERFACE_SIZE,
+	.bDescriptorType = USB_DT_INTERFACE,
+	.bNumEndpoints = 0,
+	.bInterfaceClass = USB_CLASS_AUDIO,
+	.bInterfaceSubClass = USB_SUBCLASS_AUDIOCONTROL,
+};
+
+static struct uac1_ac_header_descriptor_2 audio_sink_ac_header_desc = {
+	.bLength = SINK_UAC_DT_AC_HEADER_LENGTH,
+	.bDescriptorType = USB_DT_CS_INTERFACE,
+	.bDescriptorSubtype = UAC_HEADER,
+	.bcdADC = __constant_cpu_to_le16(0x0100),
+	.wTotalLength = __constant_cpu_to_le16(SINK_UAC_DT_TOTAL_LENGTH),
+	.bInCollection = SINK_AUDIO_NUM_INTERFACES,
+};
+
+static struct uac_input_terminal_descriptor audio_sink_input_terminal_desc = {
+	.bLength = UAC_DT_INPUT_TERMINAL_SIZE,
+	.bDescriptorType = USB_DT_CS_INTERFACE,
+	.bDescriptorSubtype = UAC_INPUT_TERMINAL,
+	.bTerminalID = SINK_INPUT_TERMINAL_ID,
+	.wTerminalType = UAC_TERMINAL_STREAMING,
+	.bAssocTerminal = 0,
+	.wChannelConfig = 0x3,
+};
+
+static struct uac_feature_unit_descriptor_0 audio_sink_feature_unit_desc = {
+	.bLength = UAC_DT_FEATURE_UNIT_SIZE(0),
+	.bDescriptorType = USB_DT_CS_INTERFACE,
+	.bDescriptorSubtype = UAC_FEATURE_UNIT,
+	.bUnitID = SINK_FEATURE_UNIT_ID,
+	.bSourceID = SINK_INPUT_TERMINAL_ID,
+	.bControlSize = 2,
+};
+
+static struct uac1_output_terminal_descriptor audio_sink_output_terminal_desc = {
+	.bLength = UAC_DT_OUTPUT_TERMINAL_SIZE,
+	.bDescriptorType = USB_DT_CS_INTERFACE,
+	.bDescriptorSubtype = UAC_OUTPUT_TERMINAL,
+	.bTerminalID = SINK_OUTPUT_TERMINAL_ID,
+	.wTerminalType = UAC_OUTPUT_TERMINAL_SPEAKER,
+	.bAssocTerminal = SINK_FEATURE_UNIT_ID,
+	.bSourceID = SINK_FEATURE_UNIT_ID,
+};
+
+static struct usb_interface_descriptor audio_sink_as_interface_alt_0_desc = {
+	.bLength = USB_DT_INTERFACE_SIZE,
+	.bDescriptorType = USB_DT_INTERFACE,
+	.bAlternateSetting = 0,
+	.bNumEndpoints = 0,
+	.bInterfaceClass = USB_CLASS_AUDIO,
+	.bInterfaceSubClass = USB_SUBCLASS_AUDIOSTREAMING,
+};
+
+static struct usb_interface_descriptor audio_sink_as_interface_alt_1_desc = {
+	.bLength = USB_DT_INTERFACE_SIZE,
+	.bDescriptorType = USB_DT_INTERFACE,
+	.bAlternateSetting = 1,
+	.bNumEndpoints = 1,
+	.bInterfaceClass = USB_CLASS_AUDIO,
+	.bInterfaceSubClass = USB_SUBCLASS_AUDIOSTREAMING,
+};
+
+static struct uac1_as_header_descriptor audio_sink_as_header_desc = {
+	.bLength = UAC_DT_AS_HEADER_SIZE,
+	.bDescriptorType = USB_DT_CS_INTERFACE,
+	.bDescriptorSubtype = UAC_AS_GENERAL,
+	.bTerminalLink = SINK_INPUT_TERMINAL_ID,
+	.bDelay = 1,
+	.wFormatTag = UAC_FORMAT_TYPE_I_PCM,
+};
+
+static struct uac_format_type_i_discrete_descriptor_1 audio_sink_as_type_i_desc = {
+	.bLength = UAC_FORMAT_TYPE_I_DISCRETE_DESC_SIZE(1),
+	.bDescriptorType = USB_DT_CS_INTERFACE,
+	.bDescriptorSubtype = UAC_FORMAT_TYPE,
+	.bFormatType = UAC_FORMAT_TYPE_I,
+	.bSubframeSize = 2,
+	.bBitResolution = 16,
+	.bSamFreqType = 1,
+};
+
+static struct usb_endpoint_descriptor audio_sink_hs_as_out_ep_desc = {
+	.bLength = USB_DT_ENDPOINT_AUDIO_SIZE,
+	.bDescriptorType = USB_DT_ENDPOINT,
+	.bEndpointAddress = USB_DIR_OUT,
+	.bmAttributes = USB_ENDPOINT_SYNC_SYNC | USB_ENDPOINT_XFER_ISOC,
+	.wMaxPacketSize = __constant_cpu_to_le16(SINK_OUT_EP_MAX_PACKET_SIZE),
+	.bInterval = 4,
+};
+
+static struct usb_endpoint_descriptor audio_sink_fs_as_out_ep_desc = {
+	.bLength = USB_DT_ENDPOINT_AUDIO_SIZE,
+	.bDescriptorType = USB_DT_ENDPOINT,
+	.bEndpointAddress = USB_DIR_OUT,
+	.bmAttributes = USB_ENDPOINT_SYNC_SYNC | USB_ENDPOINT_XFER_ISOC,
+	.wMaxPacketSize = __constant_cpu_to_le16(SINK_OUT_EP_MAX_PACKET_SIZE),
+	.bInterval = 1,
+};
+
+static struct uac_iso_endpoint_descriptor audio_sink_as_iso_out_desc = {
+	.bLength = UAC_ISO_ENDPOINT_DESC_SIZE,
+	.bDescriptorType = USB_DT_CS_ENDPOINT,
+	.bDescriptorSubtype = UAC_EP_GENERAL,
+	.bmAttributes = 1,
+	.bLockDelayUnits = 1,
+	.wLockDelay = __constant_cpu_to_le16(1),
+};
+
+static struct usb_descriptor_header *audio_sink_hs_desc[] = {
+	(struct usb_descriptor_header *)&audio_sink_ac_interface_desc,
+	(struct usb_descriptor_header *)&audio_sink_ac_header_desc,
+	(struct usb_descriptor_header *)&audio_sink_input_terminal_desc,
+	(struct usb_descriptor_header *)&audio_sink_output_terminal_desc,
+	(struct usb_descriptor_header *)&audio_sink_feature_unit_desc,
+	(struct usb_descriptor_header *)&audio_sink_as_interface_alt_0_desc,
+	(struct usb_descriptor_header *)&audio_sink_as_interface_alt_1_desc,
+	(struct usb_descriptor_header *)&audio_sink_as_header_desc,
+	(struct usb_descriptor_header *)&audio_sink_as_type_i_desc,
+	(struct usb_descriptor_header *)&audio_sink_hs_as_out_ep_desc,
+	(struct usb_descriptor_header *)&audio_sink_as_iso_out_desc,
+	NULL,
+};
+
+static struct usb_descriptor_header *audio_sink_fs_desc[] = {
+	(struct usb_descriptor_header *)&audio_sink_ac_interface_desc,
+	(struct usb_descriptor_header *)&audio_sink_ac_header_desc,
+	(struct usb_descriptor_header *)&audio_sink_input_terminal_desc,
+	(struct usb_descriptor_header *)&audio_sink_output_terminal_desc,
+	(struct usb_descriptor_header *)&audio_sink_feature_unit_desc,
+	(struct usb_descriptor_header *)&audio_sink_as_interface_alt_0_desc,
+	(struct usb_descriptor_header *)&audio_sink_as_interface_alt_1_desc,
+	(struct usb_descriptor_header *)&audio_sink_as_header_desc,
+	(struct usb_descriptor_header *)&audio_sink_as_type_i_desc,
+	(struct usb_descriptor_header *)&audio_sink_fs_as_out_ep_desc,
+	(struct usb_descriptor_header *)&audio_sink_as_iso_out_desc,
+	NULL,
+};
+
+static struct snd_pcm_hardware audio_sink_hw_info = {
+	.info = SNDRV_PCM_INFO_MMAP |
+		SNDRV_PCM_INFO_MMAP_VALID |
+		SNDRV_PCM_INFO_BATCH |
+		SNDRV_PCM_INFO_INTERLEAVED |
+		SNDRV_PCM_INFO_BLOCK_TRANSFER,
+	.formats = SNDRV_PCM_FMTBIT_S16_LE,
+	.channels_min = 2,
+	.channels_max = 2,
+	.rate_min = SINK_SAMPLE_RATE,
+	.rate_max = SINK_SAMPLE_RATE,
+	.buffer_bytes_max = 1024 * 1024,
+	.period_bytes_min = 64,
+	.period_bytes_max = 512 * 1024,
+	.periods_min = 2,
+	.periods_max = 1024,
+};
+
+struct audio_sink_config {
+	int card;
+	int device;
+};
+
+struct audio_sink_dev {
+	struct usb_function func;
+	struct snd_card *card;
+	struct snd_pcm *pcm;
+	struct snd_pcm_substream *substream;
+	struct list_head idle_reqs;
+	struct usb_ep *out_ep;
+	spinlock_t lock;
+	void *buffer_start;
+	void *buffer_end;
+	void *buffer_pos;
+	unsigned int period;
+	unsigned int period_offset;
+};
+
+static inline struct audio_sink_dev *func_to_audio_sink(struct usb_function *f)
+{
+	return container_of(f, struct audio_sink_dev, func);
+}
+
+static struct usb_request *audio_sink_request_new(struct usb_ep *ep, int buffer_size)
+{
+	struct usb_request *req = usb_ep_alloc_request(ep, GFP_KERNEL);
+	if (!req)
+		return NULL;
+	req->buf = kmalloc(buffer_size, GFP_KERNEL);
+	if (!req->buf) {
+		usb_ep_free_request(ep, req);
+		return NULL;
+	}
+	req->length = buffer_size;
+	return req;
+}
+
+static void audio_sink_request_free(struct usb_request *req, struct usb_ep *ep)
+{
+	if (req) {
+		kfree(req->buf);
+		usb_ep_free_request(ep, req);
+	}
+}
+
+static void audio_sink_req_put(struct audio_sink_dev *audio, struct usb_request *req)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&audio->lock, flags);
+	list_add_tail(&req->list, &audio->idle_reqs);
+	spin_unlock_irqrestore(&audio->lock, flags);
+}
+
+static struct usb_request *audio_sink_req_get(struct audio_sink_dev *audio)
+{
+	unsigned long flags;
+	struct usb_request *req;
+
+	spin_lock_irqsave(&audio->lock, flags);
+	if (list_empty(&audio->idle_reqs)) {
+		req = NULL;
+	} else {
+		req = list_first_entry(&audio->idle_reqs, struct usb_request, list);
+		list_del(&req->list);
+	}
+	spin_unlock_irqrestore(&audio->lock, flags);
+	return req;
+}
+
+static void audio_sink_queue(struct audio_sink_dev *audio)
+{
+	struct usb_request *req;
+	int ret;
+
+	if (!audio->buffer_start || !audio->substream)
+		return;
+
+	while ((req = audio_sink_req_get(audio))) {
+		req->length = SINK_OUT_EP_MAX_PACKET_SIZE;
+		ret = usb_ep_queue(audio->out_ep, req, GFP_ATOMIC);
+		if (ret < 0) {
+			pr_err("audio_sink usb_ep_queue failed ret: %d\n", ret);
+			audio_sink_req_put(audio, req);
+			break;
+		}
+	}
+}
+
+static void audio_sink_control_complete(struct usb_ep *ep, struct usb_request *req)
+{
+}
+
+static void audio_sink_copy(struct audio_sink_dev *audio, void *src, unsigned int length)
+{
+	unsigned int length1, length2;
+
+	if (!audio->buffer_start || !length)
+		return;
+
+	if (audio->buffer_pos + length > audio->buffer_end)
+		length1 = audio->buffer_end - audio->buffer_pos;
+	else
+		length1 = length;
+
+	memcpy(audio->buffer_pos, src, length1);
+	if (length1 < length) {
+		length2 = length - length1;
+		memcpy(audio->buffer_start, src + length1, length2);
+		audio->buffer_pos = audio->buffer_start + length2;
+	} else {
+		audio->buffer_pos += length1;
+		if (audio->buffer_pos >= audio->buffer_end)
+			audio->buffer_pos = audio->buffer_start;
+	}
+}
+
+static void audio_sink_data_complete(struct usb_ep *ep, struct usb_request *req)
+{
+	struct audio_sink_dev *audio = req->context;
+
+	if (req->status || !audio->buffer_start || !audio->substream) {
+		audio_sink_req_put(audio, req);
+		return;
+	}
+
+	audio_sink_copy(audio, req->buf, req->actual);
+	audio->period_offset += req->actual;
+	if (audio->period_offset >= audio->period) {
+		snd_pcm_period_elapsed(audio->substream);
+		audio->period_offset = 0;
+	}
+
+	req->length = SINK_OUT_EP_MAX_PACKET_SIZE;
+	if (usb_ep_queue(audio->out_ep, req, GFP_ATOMIC) < 0)
+		audio_sink_req_put(audio, req);
+}
+
+static int audio_sink_set_endpoint_req(struct usb_function *f,
+		const struct usb_ctrlrequest *ctrl)
+{
+	u16 len = le16_to_cpu(ctrl->wLength);
+
+	switch (ctrl->bRequest) {
+	case UAC_SET_CUR:
+	case UAC_SET_MIN:
+	case UAC_SET_MAX:
+	case UAC_SET_RES:
+		return len;
+	default:
+		return -EOPNOTSUPP;
+	}
+}
+
+static int audio_sink_get_endpoint_req(struct usb_function *f,
+		const struct usb_ctrlrequest *ctrl)
+{
+	struct usb_composite_dev *cdev = f->config->cdev;
+	u16 w_value = le16_to_cpu(ctrl->wValue);
+	u8 *buf = cdev->req->buf;
+
+	if (w_value != UAC_EP_CS_ATTR_SAMPLE_RATE << 8)
+		return -EOPNOTSUPP;
+
+	switch (ctrl->bRequest) {
+	case UAC_GET_CUR:
+	case UAC_GET_MIN:
+	case UAC_GET_MAX:
+	case UAC_GET_RES:
+		buf[0] = (u8)SINK_SAMPLE_RATE;
+		buf[1] = (u8)(SINK_SAMPLE_RATE >> 8);
+		buf[2] = (u8)(SINK_SAMPLE_RATE >> 16);
+		return 3;
+	default:
+		return -EOPNOTSUPP;
+	}
+}
+
+static int audio_sink_setup(struct usb_function *f, const struct usb_ctrlrequest *ctrl)
+{
+	struct usb_composite_dev *cdev = f->config->cdev;
+	struct usb_request *req = cdev->req;
+	int value = -EOPNOTSUPP;
+
+	switch (ctrl->bRequestType) {
+	case USB_DIR_OUT | USB_TYPE_CLASS | USB_RECIP_ENDPOINT:
+		value = audio_sink_set_endpoint_req(f, ctrl);
+		break;
+	case USB_DIR_IN | USB_TYPE_CLASS | USB_RECIP_ENDPOINT:
+		value = audio_sink_get_endpoint_req(f, ctrl);
+		break;
+	}
+
+	if (value >= 0) {
+		req->zero = 0;
+		req->length = value;
+		req->complete = audio_sink_control_complete;
+		value = usb_ep_queue(cdev->gadget->ep0, req, GFP_ATOMIC);
+		if (value < 0)
+			pr_err("audio_sink response err %d\n", value);
+	}
+
+	return value;
+}
+
+static int audio_sink_set_alt(struct usb_function *f, unsigned intf, unsigned alt)
+{
+	struct audio_sink_dev *audio = func_to_audio_sink(f);
+	struct usb_composite_dev *cdev = f->config->cdev;
+	int ret;
+
+	ret = config_ep_by_speed(cdev->gadget, f, audio->out_ep);
+	if (ret)
+		return ret;
+
+	usb_ep_enable(audio->out_ep);
+	return 0;
+}
+
+static void audio_sink_disable(struct usb_function *f)
+{
+	struct audio_sink_dev *audio = func_to_audio_sink(f);
+
+	usb_ep_disable(audio->out_ep);
+}
+
+static void audio_sink_build_desc(void)
+{
+	u8 *sam_freq;
+	int rate = SINK_SAMPLE_RATE;
+
+	audio_sink_input_terminal_desc.bNrChannels = 2;
+	audio_sink_as_type_i_desc.bNrChannels = 2;
+	sam_freq = audio_sink_as_type_i_desc.tSamFreq[0];
+	memcpy(sam_freq, &rate, 3);
+}
+
+static int audio_sink_bind(struct usb_configuration *c, struct usb_function *f)
+{
+	struct usb_composite_dev *cdev = c->cdev;
+	struct audio_sink_dev *audio = func_to_audio_sink(f);
+	struct usb_ep *ep;
+	struct usb_request *req;
+	int status;
+	int i;
+
+	audio_sink_build_desc();
+
+	status = usb_interface_id(c, f);
+	if (status < 0)
+		goto fail;
+	audio_sink_ac_interface_desc.bInterfaceNumber = status;
+	audio_sink_ac_header_desc.baInterfaceNr[0] = status;
+
+	status = usb_interface_id(c, f);
+	if (status < 0)
+		goto fail;
+	audio_sink_as_interface_alt_0_desc.bInterfaceNumber = status;
+	audio_sink_as_interface_alt_1_desc.bInterfaceNumber = status;
+	audio_sink_ac_header_desc.baInterfaceNr[1] = status;
+
+	status = -ENODEV;
+	ep = usb_ep_autoconfig(cdev->gadget, &audio_sink_fs_as_out_ep_desc);
+	if (!ep)
+		goto fail;
+	audio->out_ep = ep;
+	ep->driver_data = audio;
+
+	if (gadget_is_dualspeed(c->cdev->gadget))
+		audio_sink_hs_as_out_ep_desc.bEndpointAddress =
+			audio_sink_fs_as_out_ep_desc.bEndpointAddress;
+
+	f->fs_descriptors = audio_sink_fs_desc;
+	f->hs_descriptors = audio_sink_hs_desc;
+
+	for (i = 0, status = 0; i < SINK_OUT_EP_REQ_COUNT && status == 0; i++) {
+		req = audio_sink_request_new(ep, SINK_OUT_EP_MAX_PACKET_SIZE);
+		if (req) {
+			req->context = audio;
+			req->complete = audio_sink_data_complete;
+			audio_sink_req_put(audio, req);
+		} else {
+			status = -ENOMEM;
+		}
+	}
+
+fail:
+	return status;
+}
+
+static void audio_sink_unbind(struct usb_configuration *c, struct usb_function *f)
+{
+	struct audio_sink_dev *audio = func_to_audio_sink(f);
+	struct usb_request *req;
+
+	while ((req = audio_sink_req_get(audio)))
+		audio_sink_request_free(req, audio->out_ep);
+
+	snd_card_free_when_closed(audio->card);
+	audio->card = NULL;
+	audio->pcm = NULL;
+	audio->substream = NULL;
+	audio->out_ep = NULL;
+}
+
+static void audio_sink_capture_start(struct audio_sink_dev *audio)
+{
+	audio_sink_queue(audio);
+}
+
+static void audio_sink_capture_stop(struct audio_sink_dev *audio)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&audio->lock, flags);
+	audio->buffer_start = NULL;
+	audio->buffer_end = NULL;
+	audio->buffer_pos = NULL;
+	spin_unlock_irqrestore(&audio->lock, flags);
+}
+
+static int audio_sink_pcm_open(struct snd_pcm_substream *substream)
+{
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	struct audio_sink_dev *audio = substream->private_data;
+
+	runtime->private_data = audio;
+	runtime->hw = audio_sink_hw_info;
+	snd_pcm_limit_hw_rates(runtime);
+	runtime->hw.channels_max = 2;
+	audio->substream = substream;
+	return 0;
+}
+
+static int audio_sink_pcm_close(struct snd_pcm_substream *substream)
+{
+	struct audio_sink_dev *audio = substream->private_data;
+	unsigned long flags;
+
+	spin_lock_irqsave(&audio->lock, flags);
+	audio->substream = NULL;
+	audio->buffer_start = NULL;
+	audio->buffer_end = NULL;
+	audio->buffer_pos = NULL;
+	spin_unlock_irqrestore(&audio->lock, flags);
+	return 0;
+}
+
+static int audio_sink_pcm_hw_params(struct snd_pcm_substream *substream,
+		struct snd_pcm_hw_params *params)
+{
+	if (params_rate(params) != SINK_SAMPLE_RATE)
+		return -EINVAL;
+	if (params_channels(params) != 2)
+		return -EINVAL;
+
+	return snd_pcm_lib_alloc_vmalloc_buffer(substream,
+		params_buffer_bytes(params));
+}
+
+static int audio_sink_pcm_hw_free(struct snd_pcm_substream *substream)
+{
+	return snd_pcm_lib_free_vmalloc_buffer(substream);
+}
+
+static int audio_sink_pcm_prepare(struct snd_pcm_substream *substream)
+{
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	struct audio_sink_dev *audio = runtime->private_data;
+
+	audio->period = snd_pcm_lib_period_bytes(substream);
+	audio->period_offset = 0;
+	audio->buffer_start = runtime->dma_area;
+	audio->buffer_end = audio->buffer_start + snd_pcm_lib_buffer_bytes(substream);
+	audio->buffer_pos = audio->buffer_start;
+	return 0;
+}
+
+static snd_pcm_uframes_t audio_sink_pcm_pointer(struct snd_pcm_substream *substream)
+{
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	struct audio_sink_dev *audio = runtime->private_data;
+	ssize_t bytes = audio->buffer_pos - audio->buffer_start;
+
+	return bytes_to_frames(runtime, bytes);
+}
+
+static int audio_sink_pcm_capture_trigger(struct snd_pcm_substream *substream,
+		int cmd)
+{
+	struct audio_sink_dev *audio = substream->runtime->private_data;
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+		audio_sink_capture_start(audio);
+		return 0;
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+		audio_sink_capture_stop(audio);
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static struct audio_sink_dev _audio_sink_dev = {
+	.func = {
+		.name = "audio_sink",
+		.bind = audio_sink_bind,
+		.unbind = audio_sink_unbind,
+		.set_alt = audio_sink_set_alt,
+		.setup = audio_sink_setup,
+		.disable = audio_sink_disable,
+	},
+	.lock = __SPIN_LOCK_UNLOCKED(_audio_sink_dev.lock),
+	.idle_reqs = LIST_HEAD_INIT(_audio_sink_dev.idle_reqs),
+};
+
+static struct snd_pcm_ops audio_sink_capture_ops = {
+	.open = audio_sink_pcm_open,
+	.close = audio_sink_pcm_close,
+	.ioctl = snd_pcm_lib_ioctl,
+	.hw_params = audio_sink_pcm_hw_params,
+	.hw_free = audio_sink_pcm_hw_free,
+	.prepare = audio_sink_pcm_prepare,
+	.trigger = audio_sink_pcm_capture_trigger,
+	.pointer = audio_sink_pcm_pointer,
+};
+
+int audio_sink_bind_config(struct usb_configuration *c,
+		struct audio_sink_config *config)
+{
+	struct audio_sink_dev *audio = &_audio_sink_dev;
+	struct snd_card *card;
+	struct snd_pcm *pcm;
+	int err;
+
+	config->card = -1;
+	config->device = -1;
+
+	err = snd_card_new(&c->cdev->gadget->dev, SNDRV_DEFAULT_IDX1,
+		SNDRV_DEFAULT_STR1, THIS_MODULE, 0, &card);
+	if (err)
+		return err;
+
+	snd_card_set_dev(card, &c->cdev->gadget->dev);
+
+	err = snd_pcm_new(card, "USB audio sink", 0, 0, 1, &pcm);
+	if (err)
+		goto fail;
+
+	pcm->private_data = audio;
+	pcm->info_flags = 0;
+	audio->pcm = pcm;
+	strlcpy(pcm->name, "USB gadget audio sink", sizeof(pcm->name));
+	snd_pcm_set_ops(pcm, SNDRV_PCM_STREAM_CAPTURE, &audio_sink_capture_ops);
+	snd_pcm_lib_preallocate_pages_for_all(pcm, SNDRV_DMA_TYPE_DEV,
+		NULL, 0, 64 * 1024);
+
+	strlcpy(card->driver, "audio_sink", sizeof(card->driver));
+	strlcpy(card->shortname, card->driver, sizeof(card->shortname));
+	strlcpy(card->longname, "USB accessory audio sink", sizeof(card->longname));
+
+	err = snd_card_register(card);
+	if (err)
+		goto fail;
+
+	err = usb_add_function(c, &audio->func);
+	if (err)
+		goto fail;
+
+	config->card = pcm->card->number;
+	config->device = pcm->device;
+	audio->card = card;
+	return 0;
+
+fail:
+	snd_card_free(card);
+	return err;
+}
