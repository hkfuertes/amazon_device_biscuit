# Stock OTA ramdisk, kept minimal for CM12.1 bring-up.
/dev/block/platform/soc/by-name/system_a   /system      ext4   ro,noatime,commit=1,nodelalloc,discard,errors=panic        wait
/dev/block/platform/soc/by-name/userdata   /data        ext4   commit=1,noatime,nosuid,nodev,noauto_da_alloc,discard   wait,check,resize,encryptable=/dev/block/platform/soc/by-name/metadata
/dev/block/platform/soc/by-name/cache      /cache       ext4   commit=1,noatime,nosuid,nodev,noauto_da_alloc,discard   wait,check
/devices/soc/11240000.mmc*                         auto         vfat   defaults                                               voldmanaged=sdcard1:auto
/devices/platform/mt_usb                          auto         vfat   defaults                                               voldmanaged=usbotg:auto
/dev/block/zram0                                  none         swap   defaults                                               zramsize=268435456
