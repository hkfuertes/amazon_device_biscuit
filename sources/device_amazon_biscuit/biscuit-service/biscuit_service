#!/system/bin/sh

PKG=com.amazon.biscuit.service
COMP=$PKG/.BiscuitService

start() {
    ACTION="$1"
    shift
    exec am startservice -a "$ACTION" "$@" "$COMP"
}

usage() {
    cat <<EOF
usage: biscuit_service <command>

Audio:
  volume up                  raise music volume
  volume down                lower music volume
  volume set <0..max>        set music volume
  mute on|off|toggle         set/toggle real microphone mute
  mic mute|unmute|toggle     same as mute

Bluetooth:
  bt pair                    enable Bluetooth and enter pairing mode
  bt off                     disable Bluetooth / disconnect clients

WiFi:
  wifi on                    enable WiFi and reconnect saved network
  wifi connect <ssid> [psk]  save/connect WPA-PSK or open network
  wifi off                   disable WiFi

USB:
  usb conference on|off|status      UAC2 speaker+mic bridge
  usb uac2|adb                      switch exposed USB gadget
EOF
}

case "$1" in
    volume|vol)
        case "$2" in
            up|raise|+)
                start "$PKG.VOLUME_UP"
                ;;
            down|lower|-)
                start "$PKG.VOLUME_DOWN"
                ;;
            set)
                [ -n "$3" ] || { echo "missing volume" >&2; usage >&2; exit 2; }
                exec am startservice -a "$PKG.VOLUME_SET" --ei volume "$3" "$COMP"
                ;;
        esac
        ;;
    mute)
        case "$2" in
            on|mute|1|true)
                start "$PKG.MICROPHONE_MUTE_ON"
                ;;
            off|unmute|0|false)
                start "$PKG.MICROPHONE_MUTE_OFF"
                ;;
            toggle|'')
                start "$PKG.MICROPHONE_MUTE_TOGGLE"
                ;;
        esac
        ;;
    mic|microphone)
        case "$2" in
            mute|on|1|true)
                start "$PKG.MICROPHONE_MUTE_ON"
                ;;
            unmute|off|0|false)
                start "$PKG.MICROPHONE_MUTE_OFF"
                ;;
            toggle|'')
                start "$PKG.MICROPHONE_MUTE_TOGGLE"
                ;;
        esac
        ;;
    bt|bluetooth)
        case "$2" in
            pair|pairing|pairing-mode|on)
                start "$PKG.BLUETOOTH_PAIRING_MODE"
                ;;
            off|disable|stop)
                start "$PKG.BLUETOOTH_OFF"
                ;;
        esac
        ;;
    wifi)
        case "$2" in
            on)
                start "$PKG.WIFI_ON"
                ;;
            connect)
                [ -n "$3" ] || { echo "missing ssid" >&2; usage >&2; exit 2; }
                if [ -n "${4:-}" ]; then
                    exec am startservice -a "$PKG.WIFI_CONNECT" --es ssid "$3" --es psk "$4" "$COMP"
                fi
                exec am startservice -a "$PKG.WIFI_CONNECT" --es ssid "$3" "$COMP"
                ;;
            off|disable|stop)
                start "$PKG.WIFI_OFF"
                ;;
        esac
        ;;
    usb)
        case "$2" in
            conference|conf)
                case "$3" in
                    on|enable|start)
                        [ "$(getprop sys.usb.config)" = "uac2,adb" ] || setprop sys.usb.config uac2,adb
                        setprop ctl.stop conference_bridge
                        sleep 1
                        setprop ctl.start conference_bridge
                        exit $?
                        ;;
                    off|disable|stop)
                        setprop ctl.stop conference_bridge
                        killall conference_bridge >/dev/null 2>&1
                        exit 0
                        ;;
                    status|'')
                        echo "sys.usb.config=$(getprop sys.usb.config)"
                        echo "sys.usb.state=$(getprop sys.usb.state)"
                        echo "functions=$(cat /sys/class/android_usb/android0/functions 2>/dev/null)"
                        echo "state=$(cat /sys/class/android_usb/android0/state 2>/dev/null)"
                        echo "bridge_pid=$(pidof conference_bridge 2>/dev/null)"
                        echo "pcms="
                        cat /proc/asound/pcm 2>/dev/null
                        exit 0
                        ;;
                esac
                ;;
            uac2|audio|conference-gadget)
                setprop sys.usb.config uac2,adb
                exit $?
                ;;
            adb)
                setprop ctl.stop conference_bridge
                killall conference_bridge >/dev/null 2>&1
                setprop sys.usb.config adb
                exit $?
                ;;
        esac
        ;;
esac

usage
exit 2
